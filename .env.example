# =====================================================================
# Uptime Africa — configuration de DÉVELOPPEMENT
# Copier en .env :  copy .env.example .env  (Windows) / cp .env.example .env
# Aucune vraie clé ne doit figurer dans ce fichier.
# =====================================================================

APP_NAME="Uptime Africa"
APP_ENV=local
# Générée par : php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Journalisation -------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_MONITORING_LEVEL=debug

# --- Base de données ------------------------------------------------
# Développement : SQLite (aucun serveur à installer).
DB_CONNECTION=sqlite
# Pour tester avec MySQL en local (Laragon / Herd Pro) :
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=uptime_africa
# DB_USERNAME=root
# DB_PASSWORD=

# --- Sessions, cache, file d'attente --------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
# false en local (php artisan queue:listen tourne), true sur Hostinger.
QUEUE_RUN_FROM_SCHEDULER=false
QUEUE_MAX_TIME=50

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Email ----------------------------------------------------------
# En local, les emails sont écrits dans storage/logs (aucun envoi réel).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alertes@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Moteur de surveillance -----------------------------------------
UPTIME_CURRENCY=XOF
UPTIME_DISPLAY_TIMEZONE=Africa/Abidjan
# Adresse de contact affichée sur la page Abonnement (vide = masquée)
UPTIME_SUPPORT_EMAIL=
MONITOR_MIN_INTERVAL_MINUTES=5
MONITOR_REQUEST_TIMEOUT=10
MONITOR_CONCURRENCY=20
MONITOR_CYCLE_BUDGET=50
MONITOR_FAILURES_BEFORE_INCIDENT=2
MONITOR_MAX_REDIRECTS=5
MONITOR_USER_AGENT="UptimeAfricaBot/1.0"
MONITOR_RAW_RETENTION_DAYS=14

# Sonde externe (dead man's switch), ex. https://hc-ping.com/<uuid>. Vide = désactivé.
HEARTBEAT_URL=

# --- WhatsApp Cloud API (Meta) — phase 6 ----------------------------
# Côté serveur uniquement. Ne jamais exposer dans le frontend.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Administrateur général (créé par : php artisan db:seed) --------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME="Administrateur"

# Seule variable lue par le frontend (préfixe VITE_). Jamais de secret ici.
VITE_APP_NAME="${APP_NAME}"

# UptimeRobot (API v3). Clé du compte central : à renseigner sur le serveur uniquement,
# jamais dans le dépôt ni dans le navigateur (Dashboard UptimeRobot > Integrations > API).
ZITE_UPTIMEROBOT_API_KEY=
UPTIMEROBOT_SYNC_EVERY=5
