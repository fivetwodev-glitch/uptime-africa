# =====================================================================
# Uptime Africa — configuration de PRODUCTION (Hostinger mutualisé)
# Modèle uniquement : créer le vrai .env sur le serveur, hors de public_html.
# Ne JAMAIS committer le .env réel.
# =====================================================================

APP_NAME="Uptime Africa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-domaine.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_MONITORING_LEVEL=info

# Base MySQL créée dans hPanel (Bases de données > MySQL).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
# Pas de worker permanent sur mutualisé : la file est vidée par le cron.
QUEUE_RUN_FROM_SCHEDULER=true
QUEUE_MAX_TIME=50

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Boîte email créée dans hPanel (Emails). Paramètres SMTP à confirmer dans hPanel.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

UPTIME_CURRENCY=XOF
UPTIME_DISPLAY_TIMEZONE=Africa/Abidjan
# Adresse de contact affichée sur la page Abonnement (vide = masquée)
UPTIME_SUPPORT_EMAIL=
MONITOR_MIN_INTERVAL_MINUTES=5
MONITOR_REQUEST_TIMEOUT=10
MONITOR_CONCURRENCY=20
MONITOR_CYCLE_BUDGET=50
MONITOR_FAILURES_BEFORE_INCIDENT=2
MONITOR_MAX_REDIRECTS=5
MONITOR_USER_AGENT="UptimeAfricaBot/1.0"
MONITOR_RAW_RETENTION_DAYS=14

HEARTBEAT_URL=

WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME="Administrateur"

VITE_APP_NAME="${APP_NAME}"

# UptimeRobot (API v3). Clé du compte central : à renseigner sur le serveur uniquement,
# jamais dans le dépôt ni dans le navigateur (Dashboard UptimeRobot > Integrations > API).
ZITE_UPTIMEROBOT_API_KEY=
UPTIMEROBOT_SYNC_EVERY=5
